# Copy to /etc/nexus/nexus.env (root:root, 0600) and fill in the real values.
# APP_ENV=prod turns on the strict checks: SESSION_SECURE forced true, DATABASE_URL must carry ssl-mode.
APP_ENV=prod
BIND_ADDR=127.0.0.1:8080
APP_BASE_URL=https://example.com
# ssl-mode is mandatory in prod (required | verify_ca | verify_identity). Percent-encode @ : / ? in the password.
DATABASE_URL=mysql://nexus:CHANGE_ME@127.0.0.1:13306/nexus?ssl-mode=required
STATIC_BASE_URL=/static
SESSION_COOKIE_NAME=nexus_session
SESSION_SECURE=true
SESSION_TTL_HOURS=12
REQUEST_BODY_LIMIT=1048576
DB_MAX_CONNECTIONS=5
LOG_LEVEL=info
DISPLAY_TZ_OFFSET=+08:00
# Only enable when a reverse proxy really sits in front; otherwise X-Forwarded-For can be spoofed
# and the login rate limiter becomes bypassable.
TRUST_PROXY=true
# First-run only: creates the very first admin when the users table contains no admin at all.
# Delete these two lines afterwards.
# BOOTSTRAP_ADMIN_USERNAME=a_lan
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_ONE

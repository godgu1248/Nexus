[Unit]
Description=Nexus (枢纽) internal collaboration site
Documentation=file:///opt/nexus/DESIGN.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus
# 所有配置走环境变量；EnvironmentFile 里禁止出现引号包起来的整行（systemd 不做 shell 解析）
EnvironmentFile=/opt/nexus/.env
ExecStart=/opt/nexus/nexus
Restart=on-failure
RestartSec=3

# 2C2G 机器：进程能用的上限，防止内存泄漏把整机拖死
MemoryMax=512M
MemoryHigh=384M

# 最小权限：只读系统盘，只有 /opt/nexus 可写（日志走 stdout，由 journald 收）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nexus
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native

# 关停时给在途请求留时间（配合 main.rs 里的优雅关闭）
KillSignal=SIGTERM
TimeoutStopSec=20

# 日志：统一进 journald，用 journalctl -u nexus -f 看
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus

[Install]
WantedBy=multi-user.target

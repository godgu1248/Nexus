# Nexus 配置样例。复制为 .env 后按需修改；.env 不进版本库。
# 所有值都会在启动时校验，非法即拒绝启动（见 DESIGN.md §5）。

# ── 必填 ─────────────────────────────────────────────────────────────
# 数据库连接串。必须是 mysql:// 形式，口令会从报错信息里脱敏。
# **必须带 ssl-mode**：MySQL 8 起默认认证插件 caching_sha2_password 在明文连接下要求 RSA
# 公钥交换，而 sqlx 的 mysql-rsa 特性会带进 rc 依赖，所以本项目走 TLS。取值：
#   verify_ca（推荐，配 ssl-ca 校验证书链）/ required（加密但不校验）/ verify_identity（要证书带 SAN）
# 生产缺 ssl-mode 会直接拒绝启动；dev 只告警（但仍连不上，因为 RSA 后端没编进去）。
DATABASE_URL=mysql://nexus:nexus_dev_pw@127.0.0.1:3306/nexus?ssl-mode=verify_ca&ssl-ca=C:/ProgramData/MySQL/nexus-dev/data/ca.pem

# 对外可访问的站点基址，用于生成绝对链接（邮件、分享、重定向）。尾部斜杠会自动去掉。
APP_BASE_URL=http://localhost:8080

# ── 建议显式声明 ──────────────────────────────────────────────────────
# dev | prod。留空即 dev。**生产必须显式写 prod**，否则 Secure cookie 等保护不会自动开启。
APP_ENV=dev

# ── 有默认值，通常不用改 ───────────────────────────────────────────────
# 监听地址。Caddy 反代本地时保持回环，不要让 8080 暴露公网。
# BIND_ADDR=127.0.0.1:8080

# 会话 cookie 名。只能含字母、数字与 _ - .
# SESSION_COOKIE_NAME=nexus_session

# 是否只在 HTTPS 下发送会话 cookie。生产环境无论写什么都强制 true。
# SESSION_SECURE=false

# 会话有效期（小时），1–720。
# SESSION_TTL_HOURS=12

# 静态资源前缀。本地开发指向 /static；生产交给 Caddy 直出，可改成 CDN 前缀。
# STATIC_BASE_URL=/static

# 请求体上限（字节），1024–67108864。默认 1MB。
# REQUEST_BODY_LIMIT=1048576

# 数据库连接池上限。硬上限 5：2核2G 上盲目加连接只会把内存耗光，写大了会被收敛并告警。
# DB_MAX_CONNECTIONS=5

# 日志级别，等价于 RUST_LOG 的过滤串，如 info / debug / nexus=debug,tower_http=info
# LOG_LEVEL=info

# 展示时区，接受 Z / UTC / +08:00 / -0530。数据库里一律 UTC，只在渲染时转换。
# DISPLAY_TZ_OFFSET=+08:00

# 是否信任反向代理传来的 X-Forwarded-For。只有确认 Caddy 在前面时才能开。
# TRUST_PROXY=false

# ── 首个管理员引导（可选，成对出现）──────────────────────────────────────
# 只在库里**一个 admin 都没有**时生效；创建后这两个变量就彻底失效，
# 所以把它们留在环境中不会变成永久后门。
# 为什么不写进 migration：密码进 SQL 文件就等于进了 git 历史。
# 用户名 3–32 位 [A-Za-z0-9_-]；密码至少 10 位（与注册同一条规则）。
# 引导出的账号邮箱固定为 <用户名>@bootstrap.invalid（保留域，永不投递）。
# BOOTSTRAP_ADMIN_USERNAME=a_lan
# BOOTSTRAP_ADMIN_PASSWORD=

# ── 测试专用（cargo test 的集成测试使用，缺省则跳过依赖数据库的用例）────
# TEST_DATABASE_URL=mysql://nexus:nexus_dev_pw@127.0.0.1:3306/nexus_test
